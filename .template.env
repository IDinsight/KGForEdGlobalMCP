# Template for the global .env file.
# Rename this file to .env and fill in the required values.

# KG FOR EDUCATION GLOBAL MCP #
KGFEGMCP_CACHE_ROOT=caches
KGFEGMCP_CATALOG=config/catalog.json
KGFEGMCP_CONFIG=config/server.json
KGFEGMCP_CONFIG_ROOT=config
KGFEGMCP_DATA_ROOT=data
KGFEGMCP_ENV=local
KGFEGMCP_GRAPH_PACKAGES_ROOT=data/graph_packages
KGFEGMCP_INVALID_PACKAGE_POLICY=fail
KGFEGMCP_LOG_LEVEL=INFO
KGFEGMCP_LOG_ROOT=logs
KGFEGMCP_MAX_RESOURCE_BYTES=8388608
KGFEGMCP_MAX_RESOURCE_SOURCE_BYTES=33554432
KGFEGMCP_PROFILE_ROOT=config/profiles
KGFEGMCP_RESULTS_ROOT=results

# PATHS #
# 1. Do NOT include trailing slashes in paths.
PATHS_PROJECT_DIR=~/KGForEdGlobalMCP
