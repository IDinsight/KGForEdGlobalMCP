{
	"author": {
		"name": "IDinsight DSEM",
		"email": "dsem@idinsight.org"
	},
	"compatibility": {
		"platforms": [
			"darwin",
			"win32",
			"linux"
		],
		"runtimes": {
			"python": ">=3.13,<3.14"
		}
	},
	"description": "Explore, navigate, and compare immutable curriculum knowledge graph packages through MCP.",
	"display_name": "Curriculum Knowledge Graph MCP",
	"keywords": [
		"academic standards",
		"curriculum",
		"education",
		"knowledge graph",
		"mcp"
	],
	"long_description": "A curriculum-agnostic FastMCP server for discovering framework packages, searching standards, navigating hierarchy and provenance, retrieving approved resources, and producing deterministic cross-framework evidence. The server runs locally over STDIO and leaves reasoning and generation to the MCP host.",
	"manifest_version": "0.4",
	"name": "kgfegmcp",
	"server": {
		"type": "uv",
		"entry_point": "src/kgfegmcp/mcpb_server.py",
		"mcp_config": {
			"command": "uv",
			"args": [
				"run",
				"--directory",
				"${__dirname}",
				"--locked",
				"--no-dev",
				"python",
				"${__dirname}/src/kgfegmcp/mcpb_server.py"
			],
			"env": {
				"KGFEGMCP_CONFIG_ROOT": "${__dirname}/config",
				"KGFEGMCP_DATA_ROOT": "${__dirname}/data",
				"KGFEGMCP_ENV": "local",
				"KGFEGMCP_GRAPH_PACKAGES_ROOT": "${__dirname}/data/graph_packages",
				"KGFEGMCP_INVALID_PACKAGE_POLICY": "fail",
				"KGFEGMCP_LOG_LEVEL": "INFO",
				"KGFEGMCP_PROFILE_ROOT": "${__dirname}/config/profiles",
				"KGFEGMCP_PROMPT_ROOT": "${__dirname}/config/prompts",
				"PATHS_PROJECT_DIR": "${__dirname}"
			}
		}
	},
	"version": "0.1.0"
}
